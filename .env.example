# Required
OPENAI_API_KEY=sk-...

# Database (docker compose overrides the host to "db" for the app container)
DATABASE_URL=postgresql+asyncpg://folio:folio@localhost:5432/folio

# Models
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Set to -1 if your chat model rejects the temperature parameter
CHAT_TEMPERATURE=0.1
# Optional: any OpenAI-compatible endpoint
# OPENAI_BASE_URL=

# Retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=6
MIN_SIMILARITY=0.15
FTS_CONFIG=english

# Uploads
MAX_UPLOAD_MB=25
